<?xml version="1.0" encoding="UTF-8"?>
<!-- P0-007｜宿主 Keepalive launchd 配置（脱敏副本；真实安装路径 ~/Library/LaunchAgents/com.morrow.keepalive.plist）
     - 每日 07:00（宿主机本地时区 Asia/Shanghai）触发；RunAtLoad 保证每次开机/载入补跑一次
     - 进程零密码明文：token 由 scripts/keepalive-runner.sh 运行时从 keychain 读取
     - 安装/启动属需求方动作：
         cp docs/operations/com.morrow.keepalive.plist ~/Library/LaunchAgents/
         launchctl load ~/Library/LaunchAgents/com.morrow.keepalive.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.morrow.keepalive</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/wangxinkai/Documents/Morrow/scripts/keepalive-runner.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>7</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>EnvironmentVariables</key>
  <dict>
    <key>MORROW_SUPABASE_URL</key>
    <string>https://umutubzcwwmmbxfjkyvj.supabase.co</string>
    <key>TZ</key>
    <string>Asia/Shanghai</string>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/wangxinkai/Library/Logs/morrow-keepalive.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/wangxinkai/Library/Logs/morrow-keepalive.err.log</string>
</dict>
</plist>
